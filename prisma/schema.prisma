generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Package {
  id               Int      @id @default(autoincrement())
  title            String
  capacity         String
  price            String
  description      String?
  image            String?
  installationKits String?  @map("features") 
  createdAt        DateTime @default(now())
}
