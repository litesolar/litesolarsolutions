model Package {
  id               Int      @id @default(autoincrement())
  title            String
  category         String   // e.g., "panels", "inverters", "batteries", "fans", "cctv", etc.
  capacity         String?
  price            Float
  description      String?
  image            String?
  installationKits String?
  features         String?
  createdAt        DateTime @default(now())
}
