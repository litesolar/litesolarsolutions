datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Package {
  id          String   @id @default(cuid())
  title       String
  capacity    String
  price       String
  description String
  image       string
  features    String[]
  createdAt   DateTime @default(now())
}
